<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://openbox.org/
                file:///usr/share/openbox/menu.xsd">

<menu id="root-menu" label="Openbox 3">
  <item label="Zen Browser">
    <action name="Execute"><execute>zen</execute></action>
  </item>
  <item label="VS Code">
    <action name="Execute"><execute>code --no-sandbox /home/rdpuser/workspace</execute></action>
  </item>
  <item label="Flameshot">
    <action name="Execute"><execute>flameshot gui</execute></action>
  </item>
  <item label="Terminal">
    <action name="Execute"><execute>foot</execute></action>
  </item>
  <separator />
  <item label="tint2 settings">
    <action name="Execute"><execute>tint2conf</execute></action>
  </item>
  <item label="Restart">
    <action name="Restart" />
  </item>
  <item label="Exit">
    <action name="Exit" />
  </item>
</menu>

</openbox_menu>
